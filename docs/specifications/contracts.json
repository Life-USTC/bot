      "id": "bot.workspace-exam-completeness",
      "scope": "private",
      "rationale": "The personal exam command reads every page from the workspace exams endpoint, includes undated exams, and preserves each exam's own semester and course context.",
      "acceptance": {
        "given": "A schema-valid server returns 101 coherent pages with 5001 distinct owner exams, including one undated exam.",
        "when": "The production Life client reads the full collection.",
        "then": [
          "Every page is requested with owner authorization and undated inclusion; dated and undated results retain their own semester and course."
        ],
        "test": {
          "file": "internal/life/workspace_academic_contract_test.go",
          "name": "TestSpecWorkspaceExamsComplete/bot.workspace-exam-completeness"
        }
      },
