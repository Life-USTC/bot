        "when": "Inspect operation-to-decoder data flow and execute candidate search with valid and malformed typed responses.",
        "then": [
          "Every business operation has a matching generated response decoder and no handwritten HTTP request.",
          "Generated filters reach HTTP; valid fields survive projection and malformed field types fail."
        ],
        "test": {
          "file": "internal/life/generated_contract_test.go",
          "name": "TestSpecGeneratedBusinessClients/openapi.bot-generated-business-client"
        }
      },
      "sources": [
        {
          "operationId": "listSections",
          "parameters": [
            "page",
            "pageSize",
            "semesterId",
            "search"
          ],
          "responseStatus": "200",
