{
  "version": 2,
  "owner": "Bot",
  "requirements": [
    {
      "id": "bot.mcp-per-user-discovery",
      "scope": "private",
      "rationale": "Authenticated MCP discovery preserves the current bearer session's tool names, schemas and annotations; cached catalogs are isolated between grants.",
      "acceptance": {
        "given": "Two users have different authenticated MCP catalogs.",
        "when": "The real discovery path lists Alice, Bob and Alice again using one service.",
        "then": [
          "Each user sees only their own tool and exact schema/annotations."
        ],
        "test": {
          "file": "internal/agent/spec_acceptance_test.go",
          "name": "TestSpecMCPPerUserDiscovery/bot.mcp-per-user-discovery"
        }
      },
      "sources": [],
      "expectations": {
        "kind": "discovery",
        "cases": [
          {
            "id": "alice-first",
            "expected": {
              "user": "alice",
              "tools": [
                "per_user_alice"
              ],
              "schemaEqual": true,
              "annotationsEqual": true
            }
          },
          {
            "id": "bob",
            "expected": {
              "user": "bob",
              "tools": [
                "per_user_bob"
              ],
              "schemaEqual": true,
              "annotationsEqual": true
            }
          },
          {
            "id": "alice-cached",
            "expected": {
              "user": "alice",
              "tools": [
                "per_user_alice"
              ],
              "schemaEqual": true,
              "annotationsEqual": true
            }
          }
        ]
      }
    },
    {
      "id": "bot.mcp-server-authorization",
      "scope": "private",
      "rationale": "Tool discovery does not grant access: every call uses the caller's server authorization and a server denial is returned as failure.",
      "acceptance": {
        "given": "A dynamically discovered read tool rejects the caller.",
        "when": "The Bot calls that tool through its MCP session.",
        "then": [
          "The current bearer reaches the server.",
          "The denial is not returned as success or retried."
        ],
        "test": {
          "file": "internal/agent/spec_acceptance_test.go",
          "name": "TestSpecMCPServerAuthorization/bot.mcp-server-authorization"
        }
      },
      "sources": [],
      "expectations": {
        "kind": "authorization",
        "cases": [
          {
            "id": "denied",
            "expected": {
              "bearer": "Bearer restricted",
              "calls": 1,
              "error": true,
              "result": ""
            }
          }
        ]
      }
    },
