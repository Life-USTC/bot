            "/pagination/page"
          ]
        }
      ],
      "expectations": {
        "kind": "architecture",
        "cases": [
          {
            "id": "valid",
            "expected": {
              "operations": 64,
              "requestPageSize": 100,
              "rows": 1,
              "code": "MATH.01",
              "error": false
            }
          },
          {
            "id": "malformed",
            "expected": {
              "operations": 64,
              "requestPageSize": 100,
              "rows": 0,
              "code": "",
              "error": true
            }
          }
