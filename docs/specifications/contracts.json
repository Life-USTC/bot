    {
      "id": "bot.mutation-unknown-no-replay",
      "scope": "private",
      "rationale": "After interruption, a started mutation with unknown outcome remains durably unknown and is never automatically replayed.",
      "acceptance": {
        "given": "A durable write started under an expired conversation attempt.",
        "when": "A fresh session tries to recover the operation twice, offline.",
        "then": [
          "The durable result stays unknown.",
          "Recovery needs no server connection and cannot cross jobs."
        ],
        "test": {
          "file": "internal/agent/mcp_confirmation_flow_test.go",
          "name": "TestSpecMCPInterruptedWriteRecoversOfflineWithoutReplay/bot.mutation-unknown-no-replay"
        }
      },
      "sources": [],
      "expectations": {
        "kind": "confirmation",
        "cases": [
          {
            "id": "offline-recovery",
            "expected": {
              "state": "unknown",
              "remoteCalls": 0,
              "callsBeforeApproval": 0,
              "modelCalls": 0,
              "decisionRecorded": false,
              "crossJobRejected": true
            }
          }
        ]
      }
    },
    {
      "id": "bot.destructive-mutation-confirmation",
      "scope": "private",
      "rationale": "Destructive MCP writes wait for durable user approval; denial prevents execution and approval resumes the stored operation exactly once.",
      "acceptance": {
        "given": "A dynamically discovered destructive operation awaits user choice.",
        "when": "The user approves or denies and a fresh service resumes.",
        "then": [
          "No remote write occurs before approval.",
          "The stored result reflects approval, denial or an uncertain server response.",
          "A repeated model call does not repeat the write."
        ],
        "test": {
          "file": "internal/agent/mcp_confirmation_flow_test.go",
          "name": "TestSpecMCPMutationRunsThroughDurableConfirmation/bot.destructive-mutation-confirmation"
        }
      },
      "sources": [],
      "expectations": {
        "kind": "confirmation",
        "cases": [
          {
            "id": "approve",
            "expected": {
              "state": "succeeded",
              "remoteCalls": 1,
              "callsBeforeApproval": 0,
              "modelCalls": 4,
              "decisionRecorded": true,
              "crossJobRejected": false
            }
          },
          {
            "id": "deny",
            "expected": {
              "state": "denied",
              "remoteCalls": 0,
              "callsBeforeApproval": 0,
              "modelCalls": 4,
              "decisionRecorded": true,
              "crossJobRejected": false
            }
          },
          {
            "id": "unknown",
            "expected": {
              "state": "unknown",
              "remoteCalls": 1,
              "callsBeforeApproval": 0,
              "modelCalls": 4,
              "decisionRecorded": true,
              "crossJobRejected": false
            }
          }
        ]
      }
    },
